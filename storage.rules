rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Κάθε χρήστης βλέπει/ανεβάζει μόνο τα δικά του screenshots.
    // Path pattern: bet-screenshots/{userId}/{filename}
    match /bet-screenshots/{userId}/{fileName} {
      // ΠΡΟΣΟΧΗ: το request.resource υπάρχει ΜΟΝΟ στα writes. Αν τα έλεγχοι
      // μεγέθους/τύπου μπουν στο ίδιο "allow read, write", κάθε read (και το
      // getDownloadURL) αποτυγχάνει. Γι' αυτό χωρίζονται.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
